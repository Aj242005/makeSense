/* ============================================================================
   GridSense pit wall — engineering console.

   Two rules govern everything here:
     1. Command versus actual. Model output is magenta; the driver's actual is
        plain ink. Never the reverse.
     2. Enclosure discipline. A rule appears only where two coordinate systems
        meet — under a column header, along an axis, between two readouts that
        are measured differently. Panels do not get borders for being panels.

   The tone ramp is enumerated. There are no other greys in this file.
   ========================================================================= */

:root {
    /* --- tone ramp (the only neutrals) --- */
    --ground: rgb(7, 9, 11);
    --panel: rgb(14, 18, 23);
    --rule: rgb(33, 42, 52);
    --ink-dim: rgb(110, 124, 137);
    --ink: rgb(174, 186, 197);
    --ink-hi: rgb(234, 240, 245);

    /* --- hues, reserved for meaning --- */
    --command: rgb(255, 45, 155);
    --energy: rgb(53, 200, 255);
    --ok: rgb(47, 211, 122);
    --caution: rgb(240, 166, 46);
    --warning: rgb(255, 74, 74);

    --sector-best: rgb(180, 75, 255);
    --sector-personal: rgb(47, 211, 122);
    --sector-slower: rgb(240, 201, 58);

    --soft: rgb(255, 74, 74);
    --medium: rgb(240, 201, 58);
    --hard: rgb(234, 240, 245);
}

/* ---------------------------------------------------------------- shell */

.pitwall-root {
    flex-grow: 1;
    background-color: var(--ground);
    padding: 22px 26px 18px 26px;
}

/* ---------------------------------------------------------------- masthead */

.masthead {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
}

.masthead-left {
    flex-direction: column;
}

.wordmark {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--ink-hi);
    letter-spacing: 1px;
}

.wordmark-sub {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
    margin-top: 1px;
}

.masthead-right {
    flex-direction: row;
    align-items: flex-end;
}

.stat {
    flex-direction: column;
    align-items: flex-end;
    margin-left: 30px;
}

.stat-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
}

.stat-value {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--ink-hi);
    margin-top: 2px;
}

.stat-value.is-command { color: var(--command); }
.stat-value.is-energy  { color: var(--energy); }
.stat-value.is-offline { color: var(--caution); }

/* ---------------------------------------------------------------- columns */

.deck {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 16px;
}

.column {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
    margin-right: 24px;
}

.column.is-last { margin-right: 0; }

.column-head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
}

.column-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
}

.column-status {
    font-size: 10px;
    color: var(--ok);
}

.column-status.is-offline { color: var(--caution); }

.block {
    margin-top: 18px;
}

.block-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
    margin-bottom: 7px;
}

/* ---------------------------------------------------------------- readouts */

.readout {
    flex-direction: row;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 5px;
}

.readout-key {
    font-size: 12px;
    color: var(--ink-dim);
}

.readout-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink);
}

.readout-value.is-hi      { color: var(--ink-hi); }
.readout-value.is-command { color: var(--command); }
.readout-value.is-ok      { color: var(--ok); }
.readout-value.is-caution { color: var(--caution); }
.readout-value.is-warning { color: var(--warning); }
.readout-value.is-energy  { color: var(--energy); }

/* the headline pair: what the model wants, against what is happening */

.command-pair {
    flex-direction: row;
    margin-bottom: 4px;
}

.command-cell {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: column;
}

.command-cell-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
}

.command-cell-value {
    font-size: 27px;
    -unity-font-style: bold;
    color: var(--ink-hi);
    margin-top: 1px;
}

.command-cell-value.is-command { color: var(--command); }

.command-note {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--rule);
}

/* ---------------------------------------------------------------- bars */

.bar-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.bar-key {
    font-size: 11px;
    color: var(--ink-dim);
    width: 74px;
    flex-shrink: 0;
}

.bar-track {
    flex-grow: 1;
    height: 7px;
    background-color: var(--rule);
    overflow: hidden;
}

.bar-fill {
    height: 100%;
    width: 0%;
    background-color: var(--ink);
}

.bar-fill.is-energy  { background-color: var(--energy); }
.bar-fill.is-ok      { background-color: var(--ok); }
.bar-fill.is-caution { background-color: var(--caution); }
.bar-fill.is-warning { background-color: var(--warning); }
.bar-fill.is-command { background-color: var(--command); }

.bar-value {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
    width: 62px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

/* the command bug: where the model wants this bar to sit */
.bar-bug {
    position: absolute;
    top: -3px;
    width: 2px;
    height: 13px;
    background-color: var(--command);
}

.bar-track-holder {
    flex-grow: 1;
    height: 7px;
    justify-content: center;
}

/* ---------------------------------------------------------------- attribution */

/*  A signed bar growing from a centre axis. The sign carries as much
    information as the magnitude, so the axis is always drawn.  */

.attrib-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 7px;
}

.attrib-key {
    font-size: 11px;
    color: var(--ink);
    width: 118px;
    flex-shrink: 0;
}

.attrib-plot {
    flex-grow: 1;
    height: 15px;
    flex-direction: row;
    justify-content: center;
    border-left-width: 0;
}

.attrib-axis {
    position: absolute;
    width: 1px;
    height: 15px;
    background-color: var(--rule);
}

.attrib-neg,
.attrib-pos {
    position: absolute;
    height: 9px;
    top: 3px;
    width: 0%;
}

.attrib-neg { background-color: var(--ok); }
.attrib-pos { background-color: var(--warning); }

.attrib-value {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink-hi);
    width: 66px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
}

.attrib-total {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--rule);
}

.attrib-total-key {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
}

.attrib-total-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink-hi);
}

/* ---------------------------------------------------------------- corners */

.corner-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.corner {
    width: 47%;
    margin-bottom: 9px;
}

.corner-head {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
}

.corner-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
}

.corner-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--ink-hi);
}

.corner-track {
    height: 5px;
    background-color: var(--rule);
    margin-top: 3px;
    overflow: hidden;
}

.corner-fill {
    height: 100%;
    width: 0%;
    background-color: var(--ok);
}

.corner-temp {
    font-size: 10px;
    color: var(--ink-dim);
    margin-top: 2px;
}

/* ---------------------------------------------------------------- confidence */

/*  The band is drawn at its true width. Narrowing it to look confident would
    misrepresent the model, which the build spec forbids explicitly.  */

.band {
    height: 46px;
    background-color: var(--panel);
    margin-top: 4px;
    justify-content: center;
}

.band-span {
    position: absolute;
    left: 0;
    right: 0;
    background-color: rgba(53, 200, 255, 0.16);
}

.band-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--energy);
}

.band-truth {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--command);
}

.band-legend {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 4px;
}

.band-legend-item {
    font-size: 10px;
    color: var(--ink-dim);
}

/* ---------------------------------------------------------------- sectors */

.sector-row {
    flex-direction: row;
    margin-top: 2px;
}

.sector {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 6px;
}

.sector.is-last { margin-right: 0; }

.sector-bar {
    height: 2px;
    background-color: var(--rule);
}

.sector-bar.is-active   { background-color: var(--ink-hi); }
.sector-bar.is-personal { background-color: var(--sector-personal); }
.sector-bar.is-best     { background-color: var(--sector-best); }
.sector-bar.is-slower   { background-color: var(--sector-slower); }

.sector-body {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 3px;
}

.sector-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
}

.sector-time {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--ink);
}

/* ---------------------------------------------------------------- lap table */

.lap-head,
.lap-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 0 3px 0;
}

.lap-head {
    border-bottom-width: 1px;
    border-bottom-color: var(--rule);
    margin-bottom: 2px;
}

.lap-cell {
    font-size: 11px;
    color: var(--ink);
    flex-grow: 1;
    flex-basis: 0;
    -unity-text-align: middle-right;
}

.lap-cell.is-first {
    -unity-text-align: middle-left;
    flex-grow: 0;
    width: 34px;
}

.lap-head .lap-cell {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--ink-dim);
}

.lap-row.is-current .lap-cell { color: var(--ink-hi); }
.lap-cell.is-fastest { color: var(--sector-best); }

/* ---------------------------------------------------------------- offline */

.offline {
    padding: 12px 0 12px 0;
}

.offline-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--caution);
}

.offline-body {
    font-size: 11px;
    color: var(--ink-dim);
    white-space: normal;
    margin-top: 5px;
}

.hidden { display: none; }

/* ---------------------------------------------------------------- footer */

.footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--rule);
}

.footer-note {
    font-size: 10px;
    color: var(--ink-dim);
}
