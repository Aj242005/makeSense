<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PitWallDashboard.uss" />

    <ui:VisualElement name="PitWallRoot" class="pitwall-root">

        <!-- ============================================================ masthead -->
        <ui:VisualElement class="masthead">
            <ui:VisualElement class="masthead-left">
                <ui:Label text="PIT WALL" class="wordmark" />
                <ui:Label name="SessionLine" text="--" class="wordmark-sub" />
            </ui:VisualElement>

            <ui:VisualElement class="masthead-right">
                <ui:VisualElement class="stat">
                    <ui:Label text="LAP" class="stat-label" />
                    <ui:Label name="LapValue" text="--" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="STINT TIME" class="stat-label" />
                    <ui:Label name="StintValue" text="--" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="FUEL" class="stat-label" />
                    <ui:Label name="FuelValue" text="--" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat">
                    <ui:Label text="INFERENCE" class="stat-label" />
                    <ui:Label name="InferenceValue" text="OFFLINE" class="stat-value is-offline" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ deck -->
        <ui:VisualElement class="deck">

            <!-- ---------------------------------------------------- column 1: stint -->
            <ui:VisualElement class="column">
                <ui:VisualElement class="column-head">
                    <ui:Label text="STINT" class="column-title" />
                    <ui:Label name="StintStatus" text="LIVE" class="column-status" />
                </ui:VisualElement>

                <ui:VisualElement class="block">
                    <ui:Label text="CURRENT LAP" class="block-title" />
                    <ui:VisualElement class="command-pair">
                        <ui:VisualElement class="command-cell">
                            <ui:Label text="ELAPSED" class="command-cell-label" />
                            <ui:Label name="LapElapsed" text="0:00.000" class="command-cell-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="command-cell">
                            <ui:Label text="DELTA TO BEST" class="command-cell-label" />
                            <ui:Label name="LapDelta" text="--" class="command-cell-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="sector-row">
                        <ui:VisualElement class="sector">
                            <ui:VisualElement name="S1Bar" class="sector-bar" />
                            <ui:VisualElement class="sector-body">
                                <ui:Label text="S1" class="sector-label" />
                                <ui:Label name="S1Time" text="--.---" class="sector-time" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="sector">
                            <ui:VisualElement name="S2Bar" class="sector-bar" />
                            <ui:VisualElement class="sector-body">
                                <ui:Label text="S2" class="sector-label" />
                                <ui:Label name="S2Time" text="--.---" class="sector-time" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="sector is-last">
                            <ui:VisualElement name="S3Bar" class="sector-bar" />
                            <ui:VisualElement class="sector-body">
                                <ui:Label text="S3" class="sector-label" />
                                <ui:Label name="S3Time" text="--.---" class="sector-time" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="block">
                    <ui:Label text="DRIVER" class="block-title" />
                    <ui:VisualElement class="readout">
                        <ui:Label text="Speed" class="readout-key" />
                        <ui:Label name="SpeedValue" text="0 km/h" class="readout-value is-hi" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="Gear" class="readout-key" />
                        <ui:Label name="GearValue" text="N" class="readout-value is-hi" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="DRS" class="readout-key" />
                        <ui:Label name="DrsValue" text="CLOSED" class="readout-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="Gap ahead" class="readout-key" />
                        <ui:Label name="GapAheadValue" text="CLEAR" class="readout-value" />
                    </ui:VisualElement>
                    <ui:VisualElement class="readout">
                        <ui:Label text="Track evolution" class="readout-key" />
                        <ui:Label name="EvolutionValue" text="--" class="readout-value" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="block">
                    <ui:Label text="COMPLETED LAPS" class="block-title" />
                    <ui:VisualElement class="lap-head">
                        <ui:Label text="LAP" class="lap-cell is-first" />
                        <ui:Label text="TIME" class="lap-cell" />
                        <ui:Label text="COMPOUND" class="lap-cell" />
                        <ui:Label text="WEAR" class="lap-cell" />
                    </ui:VisualElement>
                    <ui:VisualElement name="LapTable" />
                    <ui:Label name="LapTableEmpty" text="No completed laps yet. Times appear here as the stint runs."
                              class="offline-body" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ------------------------------------ column 2: track 3, degradation -->
            <ui:VisualElement class="column">
                <ui:VisualElement class="column-head">
                    <ui:Label text="TRACK 3 · TYRE DEGRADATION ISOLATION" class="column-title" />
                    <ui:Label name="Track3Status" text="OFFLINE" class="column-status is-offline" />
                </ui:VisualElement>

                <ui:VisualElement name="Track3Offline" class="offline">
                    <ui:Label text="No inference running." class="offline-title" />
                    <ui:Label class="offline-body"
                              text="Add SimulationCore and Track3InferenceRunner to the scene to decompose lap time into fuel, traffic, track evolution and true tyre wear. Nothing is shown here until the model produces it." />
                </ui:VisualElement>

                <ui:VisualElement name="Track3Body" class="hidden">
                    <ui:VisualElement class="block">
                        <ui:Label text="WHERE THE LAP TIME WENT / SECONDS VS BASELINE" class="block-title" />

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Fuel load" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="FuelNeg" class="attrib-neg" />
                                <ui:VisualElement name="FuelPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="FuelValueS" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Traffic / dirty air" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="TrafficNeg" class="attrib-neg" />
                                <ui:VisualElement name="TrafficPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="TrafficValueS" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Track evolution" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="EvolutionNeg" class="attrib-neg" />
                                <ui:VisualElement name="EvolutionPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="EvolutionValueS" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="True tyre wear" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="TyreNeg" class="attrib-neg" />
                                <ui:VisualElement name="TyrePos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="TyreValueS" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-total">
                            <ui:Label text="Total observed delta" class="attrib-total-key" />
                            <ui:Label name="TotalDeltaS" text="--" class="attrib-total-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="block">
                        <ui:Label text="DEGRADATION CURVE / MEASURED AGAINST PREDICTED" class="block-title" />
                        <ui:VisualElement name="StintPlotHost" />
                    </ui:VisualElement>

                    <ui:VisualElement class="block">
                        <ui:Label text="ISOLATED WEAR / PREDICTION AGAINST GROUND TRUTH" class="block-title" />
                        <ui:VisualElement name="ConfidenceBand" class="band">
                            <ui:VisualElement name="BandSpan" class="band-span" />
                            <ui:VisualElement name="BandLine" class="band-line" />
                            <ui:VisualElement name="BandTruth" class="band-truth" />
                        </ui:VisualElement>
                        <ui:VisualElement class="band-legend">
                            <ui:Label name="BandLower" text="--" class="band-legend-item" />
                            <ui:Label name="BandPredicted" text="--" class="band-legend-item" />
                            <ui:Label name="BandUpper" text="--" class="band-legend-item" />
                        </ui:VisualElement>
                        <ui:VisualElement class="readout" style="margin-top: 8px;">
                            <ui:Label text="Physics ground truth" class="readout-key" />
                            <ui:Label name="GroundTruthValue" text="--" class="readout-value is-command" />
                        </ui:VisualElement>
                        <ui:VisualElement class="readout">
                            <ui:Label text="Residual error" class="readout-key" />
                            <ui:Label name="ResidualValue" text="--" class="readout-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="block">
                        <ui:Label text="WEAR BY CORNER" class="block-title" />
                        <ui:VisualElement class="corner-grid">
                            <ui:VisualElement class="corner">
                                <ui:VisualElement class="corner-head">
                                    <ui:Label text="FRONT LEFT" class="corner-label" />
                                    <ui:Label name="WearFL" text="--" class="corner-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="corner-track">
                                    <ui:VisualElement name="WearFillFL" class="corner-fill" />
                                </ui:VisualElement>
                                <ui:Label name="TempFL" text="--" class="corner-temp" />
                            </ui:VisualElement>
                            <ui:VisualElement class="corner">
                                <ui:VisualElement class="corner-head">
                                    <ui:Label text="FRONT RIGHT" class="corner-label" />
                                    <ui:Label name="WearFR" text="--" class="corner-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="corner-track">
                                    <ui:VisualElement name="WearFillFR" class="corner-fill" />
                                </ui:VisualElement>
                                <ui:Label name="TempFR" text="--" class="corner-temp" />
                            </ui:VisualElement>
                            <ui:VisualElement class="corner">
                                <ui:VisualElement class="corner-head">
                                    <ui:Label text="REAR LEFT" class="corner-label" />
                                    <ui:Label name="WearRL" text="--" class="corner-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="corner-track">
                                    <ui:VisualElement name="WearFillRL" class="corner-fill" />
                                </ui:VisualElement>
                                <ui:Label name="TempRL" text="--" class="corner-temp" />
                            </ui:VisualElement>
                            <ui:VisualElement class="corner">
                                <ui:VisualElement class="corner-head">
                                    <ui:Label text="REAR RIGHT" class="corner-label" />
                                    <ui:Label name="WearRR" text="--" class="corner-value" />
                                </ui:VisualElement>
                                <ui:VisualElement class="corner-track">
                                    <ui:VisualElement name="WearFillRR" class="corner-fill" />
                                </ui:VisualElement>
                                <ui:Label name="TempRR" text="--" class="corner-temp" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ------------------------------------ column 3: track 1, energy -->
            <ui:VisualElement class="column is-last">
                <ui:VisualElement class="column-head">
                    <ui:Label text="TRACK 1 · ENERGY DEPLOYMENT" class="column-title" />
                    <ui:Label name="Track1Status" text="OFFLINE" class="column-status is-offline" />
                </ui:VisualElement>

                <ui:VisualElement name="Track1Offline" class="offline">
                    <ui:Label text="No inference running." class="offline-title" />
                    <ui:Label class="offline-body"
                              text="Add SimulationCore and Track1InferenceRunner to the scene to receive a deployment recommendation, a braking call for the next zone, and a scored overtake window. No recommendation is invented in its absence." />
                </ui:VisualElement>

                <ui:VisualElement name="Track1Body" class="hidden">
                    <ui:VisualElement class="block">
                        <ui:Label text="DEPLOYMENT MODE" class="block-title" />
                        <ui:VisualElement class="command-pair">
                            <ui:VisualElement class="command-cell">
                                <ui:Label text="COMMAND" class="command-cell-label" />
                                <ui:Label name="ModeCommand" text="--" class="command-cell-value is-command" />
                            </ui:VisualElement>
                            <ui:VisualElement class="command-cell">
                                <ui:Label text="ACTUAL" class="command-cell-label" />
                                <ui:Label name="ModeActual" text="--" class="command-cell-value" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label name="Rationale" text="--" class="command-note" />
                    </ui:VisualElement>

                    <ui:VisualElement class="block">
                        <ui:Label text="NEXT BRAKING ZONE" class="block-title" />
                        <ui:VisualElement class="readout">
                            <ui:Label text="Commanded braking" class="readout-key" />
                            <ui:Label name="BrakingCommand" text="--" class="readout-value is-command" />
                        </ui:VisualElement>
                        <ui:VisualElement class="readout">
                            <ui:Label text="Overtake risk / reward" class="readout-key" />
                            <ui:Label name="RiskValue" text="--" class="readout-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="bar-row">
                            <ui:Label text="Score" class="bar-key" />
                            <ui:VisualElement class="bar-track">
                                <ui:VisualElement name="RiskFill" class="bar-fill" />
                            </ui:VisualElement>
                            <ui:Label name="RiskCategory" text="--" class="bar-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="block">
                        <ui:Label text="ENERGY BUDGET" class="block-title" />
                        <ui:VisualElement class="bar-row">
                            <ui:Label text="State of charge" class="bar-key" />
                            <ui:VisualElement class="bar-track-holder">
                                <ui:VisualElement class="bar-track">
                                    <ui:VisualElement name="SocFill" class="bar-fill is-energy" />
                                </ui:VisualElement>
                                <ui:VisualElement name="SocBug" class="bar-bug" />
                            </ui:VisualElement>
                            <ui:Label name="SocValue" text="--" class="bar-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="readout">
                            <ui:Label text="Versus heuristic baseline" class="readout-key" />
                            <ui:Label name="BudgetDelta" text="--" class="readout-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="block">
                        <ui:Label text="WHY / ATTRIBUTION WEIGHTS" class="block-title" />

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Energy surplus" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="BudgetNeg" class="attrib-neg" />
                                <ui:VisualElement name="BudgetPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="BudgetFactor" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Tyre wear penalty" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="WearPenNeg" class="attrib-neg" />
                                <ui:VisualElement name="WearPenPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="WearPenFactor" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Brake fade risk" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="BrakePenNeg" class="attrib-neg" />
                                <ui:VisualElement name="BrakePenPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="BrakePenFactor" text="--" class="attrib-value" />
                        </ui:VisualElement>

                        <ui:VisualElement class="attrib-row">
                            <ui:Label text="Overtake opportunity" class="attrib-key" />
                            <ui:VisualElement class="attrib-plot">
                                <ui:VisualElement class="attrib-axis" />
                                <ui:VisualElement name="OppNeg" class="attrib-neg" />
                                <ui:VisualElement name="OppPos" class="attrib-pos" />
                            </ui:VisualElement>
                            <ui:Label name="OppFactor" text="--" class="attrib-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ footer -->
        <ui:VisualElement class="footer">
            <ui:Label name="FooterLeft" text="P  close pit wall" class="footer-note" />
            <ui:Label name="FooterRight" text="--" class="footer-note" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
