<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/PitWallDashboard.uss?fileID=7433441132597870071&amp;guid=d189e3a70d17d8440903d61d7aa9c802&amp;type=3#PitWallDashboard" />
    
    <ui:VisualElement name="DashboardRoot" class="dashboard-root">
        <!-- TOP HEADER -->
        <ui:VisualElement name="HeaderContainer" class="header-container">
            <ui:VisualElement class="title-box">
                <ui:Label text="SF-23 #16" class="logo-badge" />
                <ui:VisualElement>
                    <ui:Label text="GridSense AI Motorsport Intelligence" class="header-title" />
                    <ui:Label name="CircuitLabel" text="Bahrain International Circuit — Grand Prix Layout" class="header-subtitle" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement class="telemetry-meta-bar">
                <ui:VisualElement class="meta-pill live-indicator">
                    <ui:Label text="SYSTEM STATUS" class="meta-pill-label" />
                    <ui:Label name="SystemStatusLabel" text="LIVE 50Hz AI" class="meta-pill-value" />
                </ui:VisualElement>
                <ui:VisualElement class="meta-pill">
                    <ui:Label text="CURRENT LAP" class="meta-pill-label" />
                    <ui:Label name="LapCounterLabel" text="LAP 14 / 20" class="meta-pill-value" />
                </ui:VisualElement>
                <ui:VisualElement class="meta-pill">
                    <ui:Label text="FUEL REMAINING" class="meta-pill-label" />
                    <ui:Label name="FuelRemainingLabel" text="78.4 kg" class="meta-pill-value" />
                </ui:VisualElement>
                <ui:VisualElement class="meta-pill">
                    <ui:Label text="STINT TIME" class="meta-pill-label" />
                    <ui:Label name="StintTimeLabel" text="21:04.82" class="meta-pill-value" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- MAIN 3-COLUMN CONTENT GRID -->
        <ui:VisualElement name="MainContent" class="main-content">
            <!-- COLUMN 1: LIVE DRIVER TELEMETRY & CHASSIS MAP -->
            <ui:VisualElement name="TelemetryColumn" class="column-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="DRIVER TELEMETRY &amp; CHASSIS" class="panel-title" />
                    <ui:Label text="50Hz CAN BUS" class="panel-tag" />
                </ui:VisualElement>

                <!-- Speed & Gear Display -->
                <ui:VisualElement class="speed-gear-container">
                    <ui:VisualElement class="gear-display">
                        <ui:Label name="GearValue" text="7" class="gear-text" />
                    </ui:VisualElement>
                    <ui:VisualElement class="speed-display">
                        <ui:Label name="SpeedValue" text="294" class="speed-value" />
                        <ui:Label text="KM / H" class="speed-unit" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- RPM Bar -->
                <ui:VisualElement class="rpm-bar-container">
                    <ui:VisualElement class="rpm-labels">
                        <ui:Label text="ENGINE SPEED" class="meta-pill-label" />
                        <ui:Label name="RpmValue" text="11,850 RPM" class="meta-pill-label" />
                    </ui:VisualElement>
                    <ui:VisualElement class="telemetry-bar-bg">
                        <ui:VisualElement name="RpmBarFill" class="rpm-bar-fill" style="width: 79%;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Throttle & Brake Pedals -->
                <ui:VisualElement class="input-bars-row">
                    <ui:VisualElement class="input-bar-group">
                        <ui:VisualElement class="rpm-labels">
                            <ui:Label text="THROTTLE" class="meta-pill-label" />
                            <ui:Label name="ThrottleValue" text="85%" class="meta-pill-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="telemetry-bar-bg">
                            <ui:VisualElement name="ThrottleBarFill" class="throttle-fill" style="width: 85%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="input-bar-group">
                        <ui:VisualElement class="rpm-labels">
                            <ui:Label text="BRAKE" class="meta-pill-label" />
                            <ui:Label name="BrakeValue" text="0%" class="meta-pill-label" />
                        </ui:VisualElement>
                        <ui:VisualElement class="telemetry-bar-bg">
                            <ui:VisualElement name="BrakeBarFill" class="brake-fill" style="width: 0%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- G-Force & DRS Readouts -->
                <ui:VisualElement class="tactical-intel-box">
                    <ui:VisualElement class="tactical-row">
                        <ui:Label text="LATERAL ACCEL" class="tactical-label" />
                        <ui:Label name="LatGValue" text="+3.42 G" class="tactical-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tactical-row">
                        <ui:Label text="LONGITUDINAL ACCEL" class="tactical-label" />
                        <ui:Label name="LongGValue" text="-0.85 G" class="tactical-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tactical-row">
                        <ui:Label text="DRS REAR WING" class="tactical-label" />
                        <ui:Label name="DrsStateLabel" text="CLOSED" class="tactical-val" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 4-Wheel Chassis Temperature Map -->
                <ui:VisualElement class="chassis-map-box">
                    <ui:VisualElement class="chassis-row">
                        <ui:VisualElement class="tyre-corner-card">
                            <ui:Label text="FRONT LEFT (FL)" class="corner-label" />
                            <ui:Label name="TyreTempFL" text="98.2°C" class="corner-temp" />
                            <ui:Label name="BrakeTempFL" text="Brake: 480°C" class="corner-sub" />
                        </ui:VisualElement>
                        <ui:VisualElement class="tyre-corner-card">
                            <ui:Label text="FRONT RIGHT (FR)" class="corner-label" />
                            <ui:Label name="TyreTempFR" text="101.5°C" class="corner-temp" />
                            <ui:Label name="BrakeTempFR" text="Brake: 510°C" class="corner-sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="chassis-row">
                        <ui:VisualElement class="tyre-corner-card">
                            <ui:Label text="REAR LEFT (RL)" class="corner-label" />
                            <ui:Label name="TyreTempRL" text="104.1°C" class="corner-temp" />
                            <ui:Label name="BrakeTempRL" text="Brake: 420°C" class="corner-sub" />
                        </ui:VisualElement>
                        <ui:VisualElement class="tyre-corner-card">
                            <ui:Label text="REAR RIGHT (RR)" class="corner-label" />
                            <ui:Label name="TyreTempRR" text="105.8°C" class="corner-temp" />
                            <ui:Label name="BrakeTempRR" text="Brake: 435°C" class="corner-sub" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- COLUMN 2: TRACK 1 ENERGY INTELLIGENCE & TACTICAL AI -->
            <ui:VisualElement name="EnergyColumn" class="column-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="TRACK 1: ENERGY DEPLOYMENT AI" class="panel-title" />
                    <ui:Label text="PPO CONVERGED" class="panel-tag" />
                </ui:VisualElement>

                <!-- Battery SoC Gauge -->
                <ui:VisualElement class="soc-gauge-card">
                    <ui:Label name="BatterySocPct" text="74.2%" class="soc-value-text" />
                    <ui:Label name="BatteryEnergyMj" text="133.6 MJ / 180.0 MJ STINT POOL" class="soc-sub-text" />
                    <ui:VisualElement class="soc-bar-bg">
                        <ui:VisualElement name="BatterySocFill" class="soc-bar-fill" style="width: 74.2%;" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Recommended Strategy Badge -->
                <ui:VisualElement class="mode-badge-container">
                    <ui:VisualElement>
                        <ui:Label text="OPTIMAL HYBRID MODE" class="meta-pill-label" />
                        <ui:Label name="PowerFlowLabel" text="Deploy: +45.0 kW | MGU-K" class="corner-sub" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ModeBadge" class="mode-badge">
                        <ui:Label name="ModeBadgeText" text="BALANCED" class="mode-badge-text" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Tactical Battle Intel -->
                <ui:VisualElement class="tactical-intel-box">
                    <ui:VisualElement class="tactical-row">
                        <ui:Label text="GAP TO CAR AHEAD" class="tactical-label" />
                        <ui:Label name="GapAheadLabel" text="+1.24s (DIRTY AIR: YES)" class="tactical-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tactical-row">
                        <ui:Label text="CLOSING RATE" class="tactical-label" />
                        <ui:Label name="ClosingRateLabel" text="+0.32 s / lap" class="tactical-val" />
                    </ui:VisualElement>
                    <ui:VisualElement class="tactical-row">
                        <ui:Label text="OVERTAKE PROBABILITY" class="tactical-label" />
                        <ui:Label name="OvertakeProbLabel" text="78.5% (WINDOW: OPEN)" class="tactical-val" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Explainability Feature Contribution Bars -->
                <ui:VisualElement class="explainability-section">
                    <ui:Label text="NEURAL POLICY FEATURE CONTRIBUTIONS" class="meta-pill-label" style="margin-bottom: 6px;" />
                    
                    <ui:VisualElement class="feature-bar-row">
                        <ui:Label text="Gap Ahead" class="feature-name" />
                        <ui:VisualElement class="feature-bar-track">
                            <ui:VisualElement name="FeatGapFill" class="feature-bar-val" style="width: 72%;" />
                        </ui:VisualElement>
                        <ui:Label name="FeatGapVal" text="+42%" class="feature-weight-text" />
                    </ui:VisualElement>

                    <ui:VisualElement class="feature-bar-row">
                        <ui:Label text="SoC Budget Margin" class="feature-name" />
                        <ui:VisualElement class="feature-bar-track">
                            <ui:VisualElement name="FeatSocFill" class="feature-bar-val" style="width: 55%;" />
                        </ui:VisualElement>
                        <ui:Label name="FeatSocVal" text="+28%" class="feature-weight-text" />
                    </ui:VisualElement>

                    <ui:VisualElement class="feature-bar-row">
                        <ui:Label text="Corner Wear Risk" class="feature-name" />
                        <ui:VisualElement class="feature-bar-track">
                            <ui:VisualElement name="FeatWearFill" class="feature-bar-val" style="width: 25%; background-color: #ef4444;" />
                        </ui:VisualElement>
                        <ui:Label name="FeatWearVal" text="-12%" class="feature-weight-text" />
                    </ui:VisualElement>

                    <ui:VisualElement class="feature-bar-row">
                        <ui:Label text="Thermal Derate Risk" class="feature-name" />
                        <ui:VisualElement class="feature-bar-track">
                            <ui:VisualElement name="FeatThermFill" class="feature-bar-val" style="width: 15%; background-color: #ef4444;" />
                        </ui:VisualElement>
                        <ui:Label name="FeatThermVal" text="-06%" class="feature-weight-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- COLUMN 3: TRACK 3 TYRE DEGRADATION ISOLATION MODEL -->
            <ui:VisualElement name="TyreColumn" class="column-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="TRACK 3: PURE TYRE ISOLATION" class="panel-title" />
                    <ui:Label text="EBM / NEURAL GAM" class="panel-tag" />
                </ui:VisualElement>

                <!-- Compound & Total Confound Delta -->
                <ui:VisualElement class="tyre-headline-card">
                    <ui:Label name="TyreCompoundBadge" text="MEDIUM (C3) — 14 LAPS" class="compound-badge" />
                    <ui:Label text="TOTAL PACE DELTA" class="meta-pill-label" />
                    <ui:Label name="TotalTyreDeltaLabel" text="+1.428s / lap" class="total-delta-text" />
                </ui:VisualElement>

                <!-- Additive Feature Confound Breakdown -->
                <ui:VisualElement class="degradation-breakdown-box">
                    <ui:Label text="ISOLATED DELTA CONTRIBUTIONS (s/lap)" class="meta-pill-label" style="margin-bottom: 6px;" />

                    <!-- 1. Pure Mechanical Wear -->
                    <ui:VisualElement class="breakdown-item">
                        <ui:VisualElement class="breakdown-item-header">
                            <ui:Label text="1. Pure Mechanical Wear" class="breakdown-label" />
                            <ui:Label name="DeltaPureWearLabel" text="+0.584s" class="breakdown-val" style="color: #ef4444;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="breakdown-bar-bg">
                            <ui:VisualElement name="BarPureWear" class="breakdown-bar-wear" style="width: 58%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 2. Thermal Penalty -->
                    <ui:VisualElement class="breakdown-item">
                        <ui:VisualElement class="breakdown-item-header">
                            <ui:Label text="2. Thermal Degradation (>100°C)" class="breakdown-label" />
                            <ui:Label name="DeltaThermalLabel" text="+0.312s" class="breakdown-val" style="color: #f59e0b;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="breakdown-bar-bg">
                            <ui:VisualElement name="BarThermal" class="breakdown-bar-thermal" style="width: 31%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 3. Fuel Mass Confound -->
                    <ui:VisualElement class="breakdown-item">
                        <ui:VisualElement class="breakdown-item-header">
                            <ui:Label text="3. Fuel Mass Correction (-32kg)" class="breakdown-label" />
                            <ui:Label name="DeltaFuelLabel" text="-0.640s" class="breakdown-val" style="color: #06b6d4;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="breakdown-bar-bg">
                            <ui:VisualElement name="BarFuel" class="breakdown-bar-fuel" style="width: 64%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 4. Traffic / Dirty Air -->
                    <ui:VisualElement class="breakdown-item">
                        <ui:VisualElement class="breakdown-item-header">
                            <ui:Label text="4. Traffic Wake &amp; Dirty Air" class="breakdown-label" />
                            <ui:Label name="DeltaTrafficLabel" text="+0.410s" class="breakdown-val" style="color: #a855f7;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="breakdown-bar-bg">
                            <ui:VisualElement name="BarTraffic" class="breakdown-bar-traffic" style="width: 41%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 5. Track Evolution -->
                    <ui:VisualElement class="breakdown-item">
                        <ui:VisualElement class="breakdown-item-header">
                            <ui:Label text="5. Track Evolution Grip (+2.8%)" class="breakdown-label" />
                            <ui:Label name="DeltaTrackLabel" text="-0.280s" class="breakdown-val" style="color: #10b981;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="breakdown-bar-bg">
                            <ui:VisualElement name="BarTrack" class="breakdown-bar-track" style="width: 28%;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Stint Strategy Call -->
                <ui:VisualElement class="strategy-call-card">
                    <ui:Label text="PIT WINDOW ADVISORY" class="strategy-title" />
                    <ui:Label name="StrategyAdvisoryText" text="Tire cliff projected in 8 laps. Box Lap 21 for HARD compound." class="strategy-desc" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- BOTTOM PANEL: SECTOR SPLITS & LAP TIMES -->
        <ui:VisualElement name="TimingPanel" class="timing-panel">
            <ui:VisualElement class="sector-boxes-row">
                <ui:VisualElement class="sector-card">
                    <ui:Label text="SECTOR 1" class="sector-title" />
                    <ui:Label name="Sector1Time" text="28.412s" class="sector-time" />
                    <ui:Label name="Sector1Delta" text="-0.084s" class="sector-delta delta-purple" />
                </ui:VisualElement>
                <ui:VisualElement class="sector-card">
                    <ui:Label text="SECTOR 2" class="sector-title" />
                    <ui:Label name="Sector2Time" text="39.105s" class="sector-time" />
                    <ui:Label name="Sector2Delta" text="+0.021s" class="sector-delta delta-yellow" />
                </ui:VisualElement>
                <ui:VisualElement class="sector-card">
                    <ui:Label text="SECTOR 3" class="sector-title" />
                    <ui:Label name="Sector3Time" text="22.840s" class="sector-time" />
                    <ui:Label name="Sector3Delta" text="-0.110s" class="sector-delta delta-green" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="lap-times-summary">
                <ui:VisualElement class="lap-stat">
                    <ui:Label text="LAST LAP" class="lap-stat-label" />
                    <ui:Label name="LastLapTime" text="1:30.357" class="lap-stat-time" />
                </ui:VisualElement>
                <ui:VisualElement class="lap-stat">
                    <ui:Label text="BEST LAP" class="lap-stat-label" />
                    <ui:Label name="BestLapTime" text="1:29.840" class="lap-stat-time" style="color: #a855f7;" />
                </ui:VisualElement>
                <ui:VisualElement class="lap-stat">
                    <ui:Label text="OPTIMAL LAP" class="lap-stat-label" />
                    <ui:Label name="OptimalLapTime" text="1:29.410" class="lap-stat-time" style="color: #10b981;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
